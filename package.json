{
  "name": "vue-chartkick",
  "version": "1.1.0",
  "description": "Create beautiful JavaScript charts with one line of Vue",
  "homepage": "https://github.com/ankane/vue-chartkick",
  "license": "MIT",
  "author": "Andrew Kane",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-chartkick.js",
  "module": "./dist/vue-chartkick.esm.js",
  "exports": {
    ".": {
      "require": "./dist/vue-chartkick.js",
      "import": "./dist/vue-chartkick.esm.js"
    }
  },
  "dependencies": {
    "chartkick": ">=3.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.25.0"
  },
  "scripts": {
    "build": "rollup -c"
  }
}
